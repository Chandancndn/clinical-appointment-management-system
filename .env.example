# Copy to .env and fill in. .env is gitignored; never commit it.

# SQLAlchemy URL for the app database. URL-encode special characters in the password.
DATABASE_URL=mysql+pymysql://cams:CHANGE_ME@localhost:3306/cams?charset=utf8mb4

# Used to run the booking tests on MySQL (pytest --engine mysql). The database name
# must end in _test because the tests drop and recreate every table in it.
# If this is unset, DATABASE_URL is used instead and must itself end in _test.
TEST_DATABASE_URL=mysql+pymysql://cams:CHANGE_ME@localhost:3306/cams_test?charset=utf8mb4

# Flask session signing key. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Shared password for every demo account created by `python -m db.seed_synthetic`.
# If unset, the seed script generates a random one and prints it.
SEED_PASSWORD=CHANGE_ME

# Set to true when the app is served over HTTPS, so the session cookie is only ever sent over HTTPS.
# SESSION_COOKIE_SECURE=true
