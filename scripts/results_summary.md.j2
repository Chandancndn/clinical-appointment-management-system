{% set _ = expect(v6('matched_to_p2', 'p50', 'p2_risk_threshold', 'mean_wait_min_vs_uniform_lo') < 0 < v6('matched_to_p2', 'p50', 'p2_risk_threshold', 'mean_wait_min_vs_uniform_hi'), 'the p50 interval against evenly spaced slots includes zero') %}
{% set _ = expect(v6('matched_to_p2', 'p50', 'p2_risk_threshold', 'mean_wait_min_vs_random_hi') < 0, 'the p50 gain against random slots excludes zero') %}
